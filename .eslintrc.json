{
    "root": true,
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:vue/vue3-recommended",
      "plugin:prettier/recommended"
    ],
    "plugins": ["vue", "prettier"],
    "rules": {
      "vue/attributes-order": "warn",
      "prettier/prettier": "error",
      "vue/multi-word-component-names": "off"
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    }
  }
  