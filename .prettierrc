{
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "trailingComma": "none",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "vueIndentScriptAndStyle": true,
    "overrides": [
      {
        "files": "*.json",
        "options": {
          "parser": "json",
          "tabWidth": 2
        }
      },
      {
        "files": "*.json5",
        "options": {
          "parser": "json5"
        }
      }
    ]
  }
  